{
  "name": "dinozaury",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data": "tsx scripts/data/build.ts && tsx scripts/data/librarian-patch.ts",
    "sim": "tsx scripts/sim.ts",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "app": "vite build && electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "icon": "node scripts/make-icon.mjs",
    "data:patch": "tsx scripts/data/librarian-patch.ts"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.1.0",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "4.3.3",
    "d3-hierarchy": "3.1.2",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "lucide-react": "^0.460.0",
    "playwright-core": "^1.48.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "topojson-client": "^3.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4",
    "world-atlas": "^2.0.2",
    "zustand": "4.5.5"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "description": "SEC — Self-Organizing Entropic Complex: gra o kolekcjonowaniu prawdziwych wymarłych zwierząt (wykopaliska, DNA, park).",
  "author": "Scepeczki",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.scepeczki.parkwymarlych",
    "productName": "SEC",
    "copyright": "Dane: The Paleobiology Database (CC BY 4.0)",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "artifactName": "SEC-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SEC – Self-Organizing Entropic Complex",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "pl_PL"
      ],
      "language": "1045"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Scepeczki",
        "repo": "SEC",
        "releaseType": "release"
      }
    ]
  }
}
